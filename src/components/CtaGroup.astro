---
import { master } from '../data/master';

interface Props {
  label?: string;
  variant?: 'primary' | 'secondary';
  tone?: 'default' | 'dark';
  size?: 'md' | 'sm';
}

const {
  label = master.primary.label,
  variant = 'primary',
  tone = 'default',
  size = 'md',
} = Astro.props;
---

<div class={`cta-group cta-group--${tone} cta-group--${size}`}>
  <a class={`btn btn-${variant} cta-group__main`} href={master.primary.href}>
    <span>{label}</span>
    <span class="arrow" aria-hidden="true">→</span>
  </a>

  <a class="cta-group__social" href={master.telegram} aria-label="Написать в Telegram" title="Telegram">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="m22 2-7 20-4-9-9-4 20-7Z M22 2 11 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>

  <a class="cta-group__social" href={master.whatsapp} aria-label="Написать в WhatsApp" title="WhatsApp">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </a>
</div>

<style>
  .cta-group {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .cta-group__social {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    background: #ffffff;
    transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
    text-decoration: none;
    flex-shrink: 0;
  }
  .cta-group__social:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .cta-group--sm .cta-group__social {
    width: 36px;
    height: 36px;
  }
  .cta-group--sm .cta-group__social svg {
    width: 15px;
    height: 15px;
  }

  .cta-group--dark .cta-group__main {
    background: var(--accent);
    color: #ffffff;
  }
  .cta-group--dark .cta-group__main:hover {
    background: #4c6841;
  }
  .cta-group--dark .cta-group__social {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.85);
  }
  .cta-group--dark .cta-group__social:hover {
    color: #ffffff;
    border-color: #ffffff;
  }
  @media (max-width: 480px) {
    .cta-group:not(.cta-group--dark) {
      flex-wrap: nowrap;
    }
    .cta-group:not(.cta-group--dark) .cta-group__main {
      padding-left: 20px;
      padding-right: 20px;
      font-size: 14.5px;
      white-space: nowrap;
    }
    .cta-group--dark .cta-group__main {
      flex-basis: 100%;
      justify-content: center;
    }
  }
</style>
