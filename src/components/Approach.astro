---
import { Image } from 'astro:assets';
import gameImg from '../assets/photos/opening-1.jpg';
import { games } from '../data/master';
---

<section id="games" class="approach">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Трансформационные игры</span>
      <h2>
        Когда ответы <em>крутятся на&nbsp;языке</em>, игра помогает
        их&nbsp;увидеть.
      </h2>
      <p>
        Игры можно пройти индивидуально или в&nbsp;группе. Для любого запроса:
        отношения, деньги, выбор, предназначение, здоровье.
      </p>
    </header>

    <div class="principles">
      {games.map((g, i) => (
        <article class="pr" data-reveal data-reveal-delay={Math.min(i * 100, 300)}>
          <span class="n">{g.kind}</span>
          <h3>{g.title}</h3>
          {g.format && <p class="dur">{g.format}</p>}
          <p>{g.text}</p>
          {g.award && <p class="award">{g.award}</p>}
          <p class="price">{g.price}{g.priceNote && <span>{g.priceNote}</span>}</p>
        </article>
      ))}
    </div>

    <figure class="strip" data-reveal>
      <Image
        src={gameImg}
        alt="Угощение с логотипом «Инсайт» на открытии центра"
        widths={[700, 1100, 1400]}
        sizes="(max-width: 860px) 92vw, 1100px"
        format="webp"
        quality={82}
        loading="lazy"
      />
    </figure>
  </div>
</section>

<style>
  .approach {
    background: var(--bg-soft);
  }
  .section-head {
    max-width: 760px;
    margin-bottom: 48px;
  }
  .section-head h2 em {
    font-style: italic;
    color: var(--accent);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }
  .pr {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 24px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .n {
    white-space: nowrap;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pr h3 {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
  }
  .pr p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-muted);
  }
  .pr .dur {
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: -4px;
  }
  .pr .price span {
    display: block;
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--ink-soft);
    margin-top: 4px;
  }
  .pr .award {
    font-size: 13px;
    color: var(--ink);
    background: var(--accent-soft);
    padding: 10px 12px;
    border-radius: 10px;
  }
  .pr .price {
    min-height: 66px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--ink);
  }

  .strip {
    margin: 0;
  }
  .strip :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 8;
    object-fit: cover;
    border-radius: 20px;
    display: block;
  }

  @media (max-width: 1024px) {
    .principles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .principles {
      grid-template-columns: 1fr;
    }
    .strip :global(img) {
      aspect-ratio: 3 / 2;
    }
  }
</style>
