---
import { Image } from 'astro:assets';
import clubImg from '../assets/photos/club.jpg';
import { helpGroups, club } from '../data/master';
---

<section id="issues" class="soft-bg">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">С чем помогаем</span>
      <h2>
        От&nbsp;отношений с&nbsp;самой собой до&nbsp;отношений
        в&nbsp;паре.
      </h2>
      <p>
        Специализация центра: отношения с&nbsp;самой собой и&nbsp;окружающими.
        Если вашей темы нет в&nbsp;списке, приходите на&nbsp;бесплатную
        диагностическую сессию: разберёмся вместе.
      </p>
    </header>

    <div class="grid">
      {helpGroups.map((g, i) => (
        <article class="group" data-reveal data-reveal-delay={Math.min(i * 90, 360)}>
          <div class="group__head">
            <span class="kind">{g.kind}</span>
          </div>
          <h3>{g.title}</h3>
          <ul>
            {g.items.map((t) => <li>{t}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <aside class="wellbeing" data-reveal>
      <div class="wb-head">
        <span class="section-eyebrow">{club.eyebrow}</span>
        <h3 class="serif wb-title">{club.title}</h3>
        <p class="muted">{club.pitch}</p>
        <ul class="wb-list">
          {club.items.map((g) => <li>{g}</li>)}
        </ul>
      </div>
      <figure class="wb-photo">
        <Image
          src={clubImg}
          alt="Гости на открытии центра «Инсайт», 22 апреля 2023"
          widths={[600, 900, 1200]}
          sizes="(max-width: 600px) 90vw, 520px"
          format="webp"
          quality={84}
          loading="lazy"
        />
        <figcaption>Открытие центра, 22&nbsp;апреля 2023</figcaption>
      </figure>
    </aside>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 72px;
  }
  .group {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .group:hover {
    transform: translateY(-2px);
    border-color: var(--accent-line);
    box-shadow: 0 20px 36px -24px rgba(31, 25, 21, 0.15);
  }
  .group__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .kind {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .group h3 {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--ink);
    margin: 0;
    font-weight: 400;
  }
  .group ul {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .group li {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-muted);
    padding-left: 14px;
    position: relative;
  }
  .group li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 6px;
    height: 1px;
    background: var(--ink-soft);
  }

  .wellbeing {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    padding: clamp(32px, 5vw, 56px);
    background: var(--ink);
    color: #e9ecef;
    border-radius: var(--radius-lg);
  }
  .wb-title {
    color: #ffffff;
    font-size: clamp(24px, 2.8vw, 34px);
    line-height: 1.15;
    margin: 12px 0 18px;
  }
  .wellbeing .section-eyebrow {
    color: var(--accent-line);
    margin: 0;
  }
  .wellbeing .muted {
    color: rgba(255, 255, 255, 0.78);
    font-size: 16px;
    line-height: 1.6;
  }
  .wb-list li {
    position: relative;
    padding-left: 18px;
  }
  .wb-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-line);
  }
  .wb-photo {
    margin: 0;
    align-self: center;
  }
  .wb-photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 16px;
    display: block;
  }
  .wb-photo figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.6);
  }
  .wb-list {
    margin-top: 22px !important;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.82);
    align-self: center;
  }

  @media (max-width: 1024px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 860px) {
    .wellbeing {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
